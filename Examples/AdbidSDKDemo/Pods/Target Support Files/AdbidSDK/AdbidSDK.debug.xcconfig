CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
CONFIGURATION_BUILD_DIR = ${PODS_CONFIGURATION_BUILD_DIR}/AdbidSDK
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/BUTTSDKFramework" "${PODS_ROOT}/AdbidSDK" "${PODS_ROOT}/Ads-CN-Beta/SDK" "${PODS_ROOT}/AnyThinkMediationAdxSmartdigimktCNAdapter/AnyThinkSmartdigimktAdapter-6.5.45.0" "${PODS_ROOT}/AnyThinkMediationGromoreAdapter/AnyThinkGromoreAdapter-7.4.0.0.0" "${PODS_ROOT}/AnyThinkiOS/core" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKCore" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKLiveBase" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKLivePlayerLite" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKLivePullVolcLog" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKPlayerCoreLiveLite" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKReachability" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKStrategyLite" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKTTFFmpegLiveLite" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKVolcLog" "${PODS_ROOT}/LeadmoadAdSDK" "${PODS_ROOT}/SmartdigimktCNSDK/KuYingSDK" "${PODS_ROOT}/UBiXDaq" "${PODS_ROOT}/UBiXMerakSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/AdbidSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/Ads-CN-Beta/BUAdLive" "${PODS_XCFRAMEWORKS_BUILD_DIR}/Ads-CN-Beta/BUAdSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/Ads-CN-Beta/CSJMediation-Only" "${PODS_XCFRAMEWORKS_BUILD_DIR}/AnyThinkMediationAdxSmartdigimktCNAdapter" "${PODS_XCFRAMEWORKS_BUILD_DIR}/AnyThinkMediationGromoreAdapter" "${PODS_XCFRAMEWORKS_BUILD_DIR}/AnyThinkiOS/AnyThinkSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/Core" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/LiveBase" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/LivePlayer/Lite" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/LivePull-VolcLog" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/PlayerCore/LiveLite" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/Reachability" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/Strategy/Lite" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/TTFFmpeg/LiveLite" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/VolcLog" "${PODS_XCFRAMEWORKS_BUILD_DIR}/LeadmoadAdSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/SmartdigimktCNSDK"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
LIBRARY_SEARCH_PATHS = $(inherited) "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_LDFLAGS = $(inherited) -framework "AVFoundation" -framework "Accelerate" -framework "AdSupport" -framework "AnyThinkSDK" -framework "AppTrackingTransparency" -framework "AudioToolbox" -framework "CoreGraphics" -framework "CoreImage" -framework "CoreLocation" -framework "CoreMedia" -framework "CoreMotion" -framework "CoreTelephony" -framework "CoreText" -framework "Foundation" -framework "ImageIO" -framework "JavaScriptCore" -framework "MapKit" -framework "MediaPlayer" -framework "MobileCoreServices" -framework "QuartzCore" -framework "SafariServices" -framework "Security" -framework "SmartdigimktSDK" -framework "StoreKit" -framework "SystemConfiguration" -framework "UIKit" -framework "WebKit" -weak_framework "AVFoundation" -weak_framework "AppTrackingTransparency" -weak_framework "AudioToolBox" -weak_framework "CoreHaptics" -weak_framework "CoreML" -weak_framework "CoreMedia" -weak_framework "CoreMotion" -weak_framework "CoreTelephony" -weak_framework "DeviceCheck" -weak_framework "MetalKit" -weak_framework "MetalPerformanceShaders" -weak_framework "MetricKit" -weak_framework "OpenAL" -weak_framework "SystemConfiguration" -weak_framework "VideoToolBox"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_DEVELOPMENT_LANGUAGE = ${DEVELOPMENT_LANGUAGE}
PODS_ROOT = ${SRCROOT}
PODS_TARGET_SRCROOT = ${PODS_ROOT}/AdbidSDK
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
PRODUCT_BUNDLE_IDENTIFIER = org.cocoapods.${PRODUCT_NAME:rfc1034identifier}
SKIP_INSTALL = YES
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
